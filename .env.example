# Copy to .env (repo root) and adjust. Never commit real secrets.

# Backend
DATABASE_URL=postgresql+asyncpg://receipts:receipts@localhost:5432/receipts
JWT_SECRET=change-me
JWT_EXPIRES_MINUTES=10080
AWS_REGION=us-east-1
S3_BUCKET=stub-dev-uploads
TEXTRACT_MODE=mock            # mock | aws
STORAGE_MODE=local            # local | s3
LOCAL_UPLOAD_DIR=./.uploads
CORS_ORIGINS=http://localhost:3000
MAX_UPLOAD_MB=10
LOW_CONFIDENCE_THRESHOLD=80
COOKIE_SECURE=false           # true in production (HTTPS only)
MOCK_TEXTRACT_DELAY_SECONDS=1.5
MOCK_UNKNOWN_FILES=empty       # empty | sample (made-up data for non-demo files; tests use it)

# Phase 4 (production; set by the CDK stack, rarely needed locally)
SQS_QUEUE_URL=                # set => extraction moves to the SQS worker; needs STORAGE_MODE=s3
DATABASE_SECRET=              # RDS secret JSON; overrides DATABASE_URL when set
EMAIL_MODE=log                # log | ses (budget alert emails)
EMAIL_FROM=Stub <alerts@example.com>
APP_BASE_URL=http://localhost:3000
LOG_FORMAT=text               # text | json
LOG_LEVEL=INFO
RATE_LIMIT_ENABLED=true
TRUSTED_PROXY_HOPS=0          # proxies that append to X-Forwarded-For (prod: 2)
AWS_PROFILE=                  # e.g. stub, for TEXTRACT_MODE=aws locally (see README)

# Frontend
API_BASE_URL=http://localhost:8000
